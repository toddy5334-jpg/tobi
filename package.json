{
  "name": "nutrimap-ai",
  "private": true,
  "version": "1.0.0",
  "description": "NutriMap AI - Sistema web de tiendas saludables, catálogo en Supabase, Google Maps y asistente Gemini AI",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/server.js",
    "start": "node dist-server/server.js",
    "preview": "vite preview",
    "clean": "node -e \"import('fs').then(f=>{f.rmSync('dist',{recursive:true,force:true});f.rmSync('dist-server',{recursive:true,force:true})})\"",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "@supabase/supabase-js": "^2.119.2",
    "@tailwindcss/vite": "^4.3.3",
    "@vis.gl/react-google-maps": "^1.10.2",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "esbuild": "^0.25.0",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
